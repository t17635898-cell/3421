-- ================================================================
RunService:BindToRenderStep("LynoriaFOV_RenderV2", 200, function()
    if library_unloaded then
        RunService:UnbindFromRenderStep("LynoriaFOV_RenderV2")
        -- Clean up
        FOV.circle:Remove()
        FOV.fill:Remove()
        FOV.glow:Remove()
        FOV.centerDot:Remove()
        for _, arm in ipairs(FOV.plusArms) do arm:Remove() end
        for _, dot in ipairs(FOV.plusEndDots) do dot:Remove() end
        return
    end

    -- Check if FOV should show
    local wallbangActive = env.WallbangController and env.WallbangController.active
    local fovManual = fovManualToggle and fovManualToggle.Value

    -- Show if wallbang is active AND manual toggle is on
    local shouldShow = wallbangActive and fovManual

    if not shouldShow then
        FOV.circle.Visible = false
        FOV.fill.Visible = false
        FOV.glow.Visible = false
        FOV.centerDot.Visible = false
        for _, arm in ipairs(FOV.plusArms) do arm.Visible = false end
        for _, dot in ipairs(FOV.plusEndDots) do dot.Visible = false end
        FOV.active = false
        return
    end

    FOV.active = true

    -- Screen center position (고정: 화면 중앙)
    local screenSize = Cam.ViewportSize
    local center = Vector2.new(screenSize.X / 2, screenSize.Y / 2)

    -- Rainbow color cycling
    FOV.hue = (FOV.hue + 0.003) % 1
    local rainbowColor = Color3.fromHSV(FOV.hue, 1, 1)
    local rainbowColor2 = Color3.fromHSV((FOV.hue + 0.15) % 1, 1, 0.9)
    local rainbowColor3 = Color3.fromHSV((FOV.hue + 0.3) % 1, 1, 0.8)
    local rainbowColor4 = Color3.fromHSV((FOV.hue + 0.45) % 1, 1, 0.95)

    -- 1. Circle outline (white, slight transparency)
    FOV.circle.Position = center
    FOV.circle.Visible = true

    -- 2. Rainbow filled circle (20% visibility = 80% transparent)
    FOV.fill.Position = center
    FOV.fill.Color = rainbowColor
    FOV.fill.Visible = true

    -- 3. Glow ring (rainbow tint)
    FOV.glow.Position = center
    FOV.glow.Color = rainbowColor3
    FOV.glow.Visible = true

    -- 4. Rotating + icon (천천히 회전)
    local rotSpeed = Options.FOVRotSpeed and Options.FOVRotSpeed.Value or 1.0
    FOV.rotationAngle = (FOV.rotationAngle + 0.008 * rotSpeed) % (math.pi * 2)

    -- 4 arms: up(0°), right(90°), down(180°), left(270°)
    local angles = {
        FOV.rotationAngle,                          -- up
        FOV.rotationAngle + math.pi / 2,             -- right
        FOV.rotationAngle + math.pi,                 -- down
        FOV.rotationAngle + 3 * math.pi / 2          -- left
    }

    local armColors = {rainbowColor, rainbowColor2, rainbowColor3, rainbowColor4}

    for i = 1, 4 do
        local a = angles[i]
        local dx = math.cos(a) * armLen
        local dy = math.sin(a) * armLen
        local gx = math.cos(a) * innerGap
        local gy = math.sin(a) * innerGap

        FOV.plusArms[i].From = center + Vector2.new(gx, gy)
        FOV.plusArms[i].To = center + Vector2.new(dx, dy)
        FOV.plusArms[i].Color = armColors[i]
        FOV.plusArms[i].Visible = true

        -- End dots
        FOV.plusEndDots[i].Position = center + Vector2.new(dx, dy)
        FOV.plusEndDots[i].Color = armColors[i]
        FOV.plusEndDots[i].Visible = true
    end

    -- 5. Center dot
    if Options.FOVCenterDot and Options.FOVCenterDot.Value then
        FOV.centerDot.Position = center
        FOV.centerDot.Color = rainbowColor4
        FOV.centerDot.Visible = true
    else
        FOV.centerDot.Visible = false
    end
end)

