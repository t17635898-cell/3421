-- Desync Controller
env.DesyncController = {}
do
    function env.DesyncController:init()
        self.active = false
        self.connection = nil
        self.currentTarget = nil
    end

    function env.DesyncController:Start(target)
        self:Stop()
        self.active = true

        self.connection = WRunService.Heartbeat:Connect(function()
            if not self.active then return end

            local rootPart = WCharacter.RootPart
            if not rootPart then return end

            local targetRoot = target and target.Character and target.Character:FindFirstChild('HumanoidRootPart')
            if not targetRoot then
                self:Stop()
                return
            end

            self.currentTarget = target

            local desyncCFrame = targetRoot.CFrame * CFrame.new(0, 7, -2)
            local backupCFrame = rootPart.CFrame
            local backupVelocity = rootPart.Velocity
            local backupRotVelocity = rootPart.RotVelocity

            rootPart.CFrame = desyncCFrame

            WRunService:BindToRenderStep('desync_fallback', 101, function()
                rootPart.CFrame = backupCFrame
                rootPart.Velocity = backupVelocity
                rootPart.RotVelocity = backupRotVelocity
                WRunService:UnbindFromRenderStep('desync_fallback')
            end)
        end)
    end

    function env.DesyncController:Stop()
        self.active = false
        self.currentTarget = nil
        if self.connection then
            self.connection:Disconnect()
            self.connection = nil
        end
    end

    env.DesyncController:init()
end

-- Target Controller
env.TargetController = {}
do
    function env.TargetController:init()
        self.active = true
        self.target = nil

        self.connection = WRunService.Heartbeat:Connect(function()
            if not self.active then return end
            self.target = self:GetClosestTarget()
        end)
    end

    function env.TargetController:IsValidTarget(character)
        local rootPart = character:FindFirstChild('HumanoidRootPart')
        local head = character:FindFirstChild('Head')
        local humanoid = character:FindFirstChildWhichIsA('Humanoid')
        return rootPart and head and humanoid and humanoid.Health > 0 or false
    end

    function env.TargetController:IsValidTeam(player)
        return player:GetAttribute('TeamID') ~= WLocalPlayer:GetAttribute('TeamID')
    end

    function env.TargetController:GetClosestTarget()
        local closestTarget = nil
        local maxDistance = math.huge
        local mousePos = WUserInputService:GetMouseLocation()

        for _, player in next, WPlayers:GetPlayers() do
            if player == WLocalPlayer then continue end
            if not self:IsValidTeam(player) then continue end

            local character = player.Character
            if not character then continue end
            if not self:IsValidTarget(character) then continue end

            local rootPart = character.HumanoidRootPart
            local screenPos, onScreen = WCamera:WorldToViewportPoint(rootPart.Position)
            if not onScreen then continue end

            local rootPos = Vector2.new(screenPos.X, screenPos.Y)
            local targetDist = (mousePos - rootPos).magnitude
            if targetDist > maxDistance then continue end

            maxDistance = targetDist
            closestTarget = player
        end

        return closestTarget
    end

    function env.TargetController:Stop()
        self.active = false
        if self.connection then
            self.connection:Disconnect()
            self.connection = nil
        end
    end

    env.TargetController:init()
end

