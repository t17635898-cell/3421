-- [ PROJECTILE TP ]
local TARGET_FOLDERS = {["Daggers"] = true, ["Bow"] = true, ["Slingshot"] = true}
local attached = setmetatable({}, { __mode = "k" })

local function GetClosestPlayerHead()
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local closestHead, shortest = nil, math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not IsTeam(plr) then
            local char = plr.Character
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local dist = (myHRP.Position - head.Position).Magnitude
                if dist < shortest then shortest = dist; closestHead = head end
            end
        end
    end
    return closestHead
end

local function AttachPartToClosestHead(part)
    if not part or not part:IsA("BasePart") or attached[part] then return end
    attached[part] = true
    part.CanCollide = false; part.Massless = true
    pcall(function() if part:IsA("BasePart") and not part.Anchored then part:SetNetworkOwner(LocalPlayer) end end)
    task.spawn(function()
        while part and part.Parent and Toggles.ProjectileTP and Toggles.ProjectileTP.Value do
            local head = GetClosestPlayerHead()
            if head and head.Parent then
                part.AssemblyLinearVelocity = Vector3.zero; part.AssemblyAngularVelocity = Vector3.zero
                part.Velocity = Vector3.zero; part.RotVelocity = Vector3.zero
                part.CFrame = head.CFrame
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function HandleInstance(inst)
    if not inst or not inst.Parent then return end
    if inst:IsA("BasePart") then AttachPartToClosestHead(inst); return end
    if inst:IsA("Model") or inst:IsA("Folder") then
        for _, d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then AttachPartToClosestHead(d) end end
    end
end

local function HookFolder(folder)
    for _, d in ipairs(folder:GetDescendants()) do HandleInstance(d) end
    folder.DescendantAdded:Connect(function(desc) if Toggles.ProjectileTP and Toggles.ProjectileTP.Value then HandleInstance(desc) end end)
end

local function TryStartProjectileTP()
    for _, child in ipairs(Workspace:GetChildren()) do if TARGET_FOLDERS[child.Name] then HookFolder(child) end end
    Workspace.ChildAdded:Connect(function(child) if TARGET_FOLDERS[child.Name] and Toggles.ProjectileTP and Toggles.ProjectileTP.Value then HookFolder(child) end end)
end
if LocalPlayer.Character then TryStartProjectileTP() else LocalPlayer.CharacterAdded:Wait(); TryStartProjectileTP() end

-- NoRecoil + NoSpread + InstantHit + RapidFire hook
if clientItemModule then
    local origRecoil = rawget(clientItemModule, "_Recoil")
    if origRecoil then
        rawset(clientItemModule, "_Recoil", function(...) if Toggles.NoRecoil and Toggles.NoRecoil.Value then return end return origRecoil(...) end)
    end
    local originalInput = rawget(clientItemModule, "Input")
    if originalInput then
        rawset(clientItemModule, "Input", function(self, ...)
            if self and type(self) == "table" then
                local info = rawget(self, "Info")
                if info then
                    if Toggles.NoSpread and Toggles.NoSpread.Value then rawset(info, "ShootSpread", 0) end
                    if Options.InstantHit then
                        local v = Options.InstantHit.Value
                        local origSpeed = rawget(info, "ProjectileSpeed")
                        rawset(info, "ProjectileSpeed", (v == 100 and origSpeed) or (99999999 / v))
                    end
                    if Options.RapidFire then
                        local v = Options.RapidFire.Value
                        local origCooldown = rawget(info, "ShootCooldown")
                        local origQuick = rawget(info, "QuickShotCooldown")
                        rawset(info, "ShootCooldown", (v == 100 and origCooldown) or (v / 100))
                        rawset(info, "QuickShotCooldown", (v == 100 and origQuick) or (v / 100))
                    end
                end
            end
            return originalInput(self, ...)
        end)
    end
end

