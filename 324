-- Team check
local function IsTeam(p)
    if not p or p == LocalPlayer then return false end
    local success1, playerTeamID = pcall(function() return p:GetAttribute("TeamID") end)
    local success2, localTeamID = pcall(function() return LocalPlayer:GetAttribute("TeamID") end)
    if success1 and success2 and playerTeamID and localTeamID then
        return playerTeamID == localTeamID
    end
    return false
end

-- 강화된 isCharAlive (사망 감지 정확도 ↑)
local function isCharAlive(char)
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local s, h = pcall(function() return hum.Health end)
    if not s then return false end
    if h <= 0 then return false end
    -- 추가: Humanoid 상태 체크
    local s2, state = pcall(function() return hum:GetState() end)
    if s2 and (state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.PhysicsImpact) then
        return false
    end
    return true
end

