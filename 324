            local result = {self.startShootingRef(controller, ...)}

            local clientFighter = controller.ClientFighter
            if not clientFighter.IsLocalPlayer then
                return unpack(result)
            end

            local cameraData = result[3]
            if not cameraData or typeof(cameraData) ~= 'table' then
                return unpack(result)
            end

            -- No spread
            result[4] = true

            local targetPlayer = env.TargetController.target
            if not self.active or not targetPlayer or (targetPlayer and not targetPlayer.Character) then
                return unpack(result)
            end

            -- Desync to target
            if env.DesyncController.currentTarget ~= targetPlayer then
                env.DesyncController:Start(targetPlayer)
                task.wait(0.1)
            end

            if self.desyncCleanup then
                task.cancel(self.desyncCleanup)
                self.desyncCleanup = nil
            end

            -- Wallbang: teleport camera to behind target
            local targetHead = targetPlayer.Character.Head
            local targetPos = targetHead.Position
            local targetCFrame = targetHead.CFrame

            local shootingPos = targetHead.Position - Vector3.new(0, 8, 0)
            local shootingOffset = targetCFrame:ToObjectSpace(CFrame.new(targetPos + Vector3.new(math.random(), math.random(), math.random())))

            cameraData[utf8.char(0)] = WUtility:EncodeCFrame(CFrame.new(shootingPos, targetPos) * CFrame.Angles(CFrame.lookAt(shootingPos, targetPos):ToOrientation()))
            cameraData[utf8.char(1)] = WUtility:EncodeCFrame(CFrame.new(targetPos) * CFrame.Angles(CFrame.lookAt(shootingPos, targetPos):ToOrientation()))
            cameraData[utf8.char(2)] = targetHead
            cameraData[utf8.char(3)] = WUtility:EncodeCFrame(shootingOffset)

            self.desyncCleanup = task.delay(0.15, function()
                env.DesyncController:Stop()
            end)

            return unpack(result)
        end
    end

    function env.WallbangController:Stop()
        self.active = false
        WGunItem.StartShooting = self.startShootingRef
        if self.desyncCleanup then
            task.cancel(self.desyncCleanup)
            self.desyncCleanup = nil
        end
    end

    env.WallbangController:init()
end

